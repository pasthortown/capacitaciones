# ----- Entorno / secretos -----
.env
.env.*
!.env.example

# ----- Node / Frontend -----
node_modules/
dist/
build/
.vite/
coverage/
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- .NET / Backend -----
bin/
obj/
*.user
*.suo
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
TestResults/
*.nupkg
*.snupkg
artifacts/

# ----- SQL Server datos locales -----
infra/sqlserver/data/
infra/sqlserver/log/
infra/sqlserver/secrets/

# ----- Sonar / ZAP -----
infra/sonarqube/data/
infra/sonarqube/logs/
infra/sonarqube/extensions/
infra/sonarqube/postgres/
security/reports/*
!security/reports/.gitkeep
.scannerwork/
.sonarqube/

# ----- Certificados generados -----
output/*
!output/.gitkeep

# Repositorio de material compartido (archivos subidos por admin)
/repository/*
!/repository/.gitkeep

# Imagenes (logos) de capacitaciones (subidas por admin/capacitador)
/imagen_capacitaciones/*
!/imagen_capacitaciones/.gitkeep

# ----- IDE / OS -----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- Claude Code local settings (may leak local paths) -----
.claude/settings.local.json
**/.claude/settings.local.json

# ----- Claves privadas TLS / SSL — NUNCA committear -----
*.key
*-private-key.*
*private-key*
SSL/generated-private-key.txt
SSL/generated-csr.txt

# ----- Otros -----
*.tmp
*.bak

# Python bytecode
__pycache__/
*.pyc

# Anexos de convenios (archivos subidos)
/convenios_anexos/*
!/convenios_anexos/.gitkeep
