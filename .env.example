# Plantilla de variables de entorno para docker-compose.
# Copia este archivo como `.env` en la raiz del repo y reemplaza los valores.
# NO versionar `.env` con valores reales.

# --- Puertos del host (override solo si hay conflictos, ej. produccion) ---
# NGINX_HTTP_PORT=80
# BACKEND_HTTP_PORT=8080
# SQLSERVER_PORT=1433

# --- SQL Server ---
# Politica SQL Server: >= 8 chars, mayuscula, minuscula, numero y simbolo.
SA_PASSWORD=change_me_strong_password
CONNECTION_STRING=Server=sqlserver,1433;Database=Capacitaciones;User Id=sa;Password=change_me_strong_password;TrustServerCertificate=True;

# --- JWT (backend .NET) ---
JWT_SECRET=change_me_32_chars_or_more
JWT_ISSUER=capacitaciones-api
JWT_AUDIENCE=capacitaciones-web

# --- SonarQube DB ---
SONAR_DB_PASSWORD=change_me

# --- OWASP ZAP ---
ZAP_API_KEY=change_me

# --- Admin inicial (seed al arrancar el backend en Development) ---
ADMIN_EMAIL=admin@dos.com.ec
ADMIN_PASSWORD=change_me_strong_password

# --- Repositorio de material (httpd + volumen compartido) ---
# Ruta DENTRO del contenedor backend donde se guardan los archivos subidos.
# Debe coincidir con el volumen compartido con repository_httpd.
REPOSITORIO_DIR=/repository

# --- Imagenes (logos) de capacitaciones ---
# Ruta DENTRO de los contenedores backend (RW) y emisor_documentos (RO) donde
# se guardan los logos. Servidos por repository_httpd bajo el alias /imagenes/.
# Ya tiene default en docker-compose.yml; descomentar solo si se quiere overridear.
# IMAGEN_CAPACITACIONES_DIR=/imagen_capacitaciones

# --- SMTP (servicio mail_sender) ---
# En producción se usa SMTP submission de Office 365 (puerto 587 + STARTTLS +
# login). El connector MX directo (puerto 25 sin auth) está bloqueado por el
# firewall corporativo de salida; si en el futuro se abre, se puede dejar
# SMTP_PASSWORD vacío y apuntar SMTP_HOST=dos-com-ec.mail.protection.outlook.com
# con SMTP_PORT=25 — mail_sender omite el LOGIN cuando la contraseña está vacía.
#
# SMTP_FROM       = email del remitente visible (puede ser un alias).
# SMTP_FROM_NAME  = display name del remitente. Si está, el header From es
#                   "Display <email>"; si está vacío, va solo el email.
# SMTP_USER       = usuario para autenticar contra el servidor SMTP. Solo
#                   necesario si difiere de SMTP_FROM (alias con permiso
#                   *Send As* en Office 365). Si se omite, se autentica con
#                   SMTP_FROM.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_FROM=change_me@dos.com.ec
SMTP_FROM_NAME=CapacitaDOS
SMTP_USER=
SMTP_PASSWORD=change_me
SMTP_USE_TLS=true

# Origen del logo para las plantillas de correo. Si está vacío, mail_sender
# embebe assets/logo.png como data URI base64 (útil mientras la app no es
# pública). Cuando el front esté publicado en un dominio, fijar la URL
# absoluta del PNG (ej. https://capacitaciones.dos.com.ec/logo.png).
LOGO_URL=

# --- Notificaciones del backend (URL pública del front) ---
# URL absoluta donde está publicado el SPA (sin slash final). Se usa para
# armar los enlaces que viajan por correo (ej. enlace de inscripción).
PUBLIC_BASE_URL=https://capacitados.dos.com.ec
